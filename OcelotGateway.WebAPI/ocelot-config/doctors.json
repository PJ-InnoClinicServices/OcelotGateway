{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/doctors",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 8086
        }
      ],
      "UpstreamPathTemplate": "/ocelot/api/doctors",
      "UpstreamHttpMethod": ["GET", "POST"],
      "RateLimitOptions": {
        "DisableRateLimitHeaders": false,
        "QuotaExceededMessage": "Customize Tips!",
        "HttpStatusCode": 418,
        "ClientIdHeader": "MyRateLimiting",
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "1m",
        "PeriodTimespan": 1,
        "Limit": 100
      }
    },
    {
      "DownstreamPathTemplate": "/api/doctors/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 8086
        }
      ],
      "UpstreamPathTemplate": "/ocelot/api/doctors/{id}",
      "UpstreamHttpMethod": ["GET", "PUT", "DELETE"],
      "RateLimitOptions": {
        "DisableRateLimitHeaders": false,
        "QuotaExceededMessage": "Customize Tips!",
        "HttpStatusCode": 418,
        "ClientIdHeader": "MyRateLimiting",
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "1m",
        "PeriodTimespan": 1,
        "Limit": 100
      }
    }
  ]
}
